{
  "name": "mod-dwarf-mcp",
  "version": "0.1.2",
  "description": "Read-only MCP server for inspecting MOD Dwarf pedalboards, plugins, snapshots, and banks.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mod-dwarf-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mcp",
    "mod-dwarf",
    "lv2",
    "pedalboard",
    "model-context-protocol"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.10.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0",
    "dotenv": "^16.4.7",
    "ssh2": "^1.16.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/ssh2": "^1.15.4",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ]
}
